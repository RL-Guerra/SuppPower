# Configurações da Stone (Gateway de Pagamento)
VITE_STONE_APPLICATION_ID=seu_application_id_aqui
VITE_STONE_SECRET_KEY=sua_secret_key_aqui

# Configurações do EmailJS (opcional)
VITE_EMAILJS_SERVICE_ID=service_gmail
VITE_EMAILJS_TEMPLATE_ID=template_order
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Ambiente (development/production)
NODE_ENV=development